    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
    "test:unit": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service test:unit",
    "prepare:ffmpeg": "node scripts/copy-ffmpeg.js",
    "postinstall": "node scripts/copy-ffmpeg.js"
  },
  "overrides": {
    "@vue/cli-plugin-unit-jest": {
      "jest": "26.6.3",
      "babel-jest": "26.6.3",
      "ts-jest": "26.5.6",
